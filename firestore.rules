rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A trip is reachable only by someone who knows its long random code:
    // you can open /trips/<code> and everything under it, but nobody can
    // list or browse all trips. Deleting is allowed so the creator can remove
    // a trip (the app only shows the Delete button on the creator's phone).
    match /trips/{code} {
      allow get, create, update, delete: if true;
      allow list: if false;
      match /{sub}/{doc} {
        allow read, write: if true;
      }
    }
  }
}
