rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A trip is reachable only by someone who knows its long random code (12 characters, about 60 bits of randomness -
    // far too many to guess): you can open /trips/<code> and everything under it, but nobody can list or browse all
    // trips. Deleting is allowed so the creator can remove a trip (the app only shows Delete on the creator's phone).
    //
    // Extra safety on top:
    //  - once a trip has a creator (owner_hash), nobody can swap it for their own;
    //  - only the app's own sub-collections can be used, and documents can't be stuffed with huge numbers of fields.
    match /trips/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().size() <= 40;
      allow update: if request.resource.data.keys().size() <= 40
        && (!('owner_hash' in resource.data) || request.resource.data.owner_hash == resource.data.owner_hash);
      allow delete: if true;

      match /{sub}/{doc} {
        allow read, delete: if sub in ['expenses', 'settlements', 'deleted', 'activity', 'adjustments', 'notes'];
        allow create, update: if sub in ['expenses', 'settlements', 'deleted', 'activity', 'adjustments', 'notes']
          && request.resource.data.keys().size() <= 60;
      }
    }
  }
}
